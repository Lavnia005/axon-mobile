{
  "expo": {
    "name": "Axon",
    "slug": "axon-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "axonmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1420",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.equipeaxon.axon"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/axon-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0F1420",
          "dark": {
            "image": "./assets/images/axon-logo.png",
            "backgroundColor": "#0F1420"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o Axon acesse suas fotos para atualizar seu perfil e enviar evidências.",
          "cameraPermission": "Permita que o Axon use a câmera para atualizar seu perfil e registrar evidências.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ab502fd1-3af9-4084-b079-63c04ed3d886"
      }
    }
  }
}
